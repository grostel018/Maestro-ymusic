{
	"name": "maestro-workspace",
	"version": "0.0.0",
	"private": true,
	"author": "Venipa <admin@venipa.net>",
	"homepage": "https://youtube-music.app",
  "description": "Unofficial YouTube Music Desktop App for Windows, Mac and Linux | Monorepo",
	"scripts": {
		"format": "pnpm --filter maestro format",
		"lint": "pnpm --filter maestro lint",
		"typecheck": "pnpm --filter maestro typecheck",
		"start": "pnpm --filter maestro start",
		"dev": "pnpm --filter maestro dev",
		"build": "pnpm --filter maestro build",
		"release:nocheck": "pnpm --filter maestro release:nocheck",
		"release": "pnpm --filter maestro release",
		"release:compile": "pnpm --filter maestro release:compile",
		"release:pack": "pnpm --filter maestro release:pack",
		"release:pack:win": "pnpm --filter maestro release:pack:win",
		"release:pack:mac": "pnpm --filter maestro release:pack:mac",
		"release:pack:linux:core": "pnpm --filter maestro release:pack:linux:core",
		"release:pack:linux:arm": "pnpm --filter maestro release:pack:linux:arm",
		"release:pack:linux:flatpak": "pnpm --filter maestro release:pack:linux:flatpak",
		"build:unpack": "pnpm --filter maestro build:unpack",
		"build:win": "pnpm --filter maestro build:win",
		"build:mac": "pnpm --filter maestro build:mac",
		"build:linux": "pnpm --filter maestro build:linux",
		"biome:lint": "pnpm --filter maestro biome:lint",
		"biome:format": "pnpm --filter maestro biome:format",
		"biome:check": "pnpm --filter maestro biome:check",
		"biome:check:apply": "pnpm --filter maestro biome:check:apply",
		"streamdeck:build": "pnpm --filter maestro-streamdeck build",
		"streamdeck:icons": "pnpm --filter maestro-streamdeck icons",
		"streamdeck:pack": "pnpm --filter maestro-streamdeck run pack",
		"userscript:dev": "pnpm --filter maestro-userscript dev",
		"userscript:build": "pnpm --filter maestro-userscript build",

		"docs:dev": "pnpm --filter maestro-docs dev",
		"docs:build": "pnpm --filter maestro-docs build",
		"docs:build:pages": "pnpm --filter maestro-docs build:pages",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm --filter maestro test:e2e",
		"test:perf": "pnpm --filter maestro test:perf",
		"t:unit": "vitest run",
		"t:smoke": "pnpm --filter maestro t:smoke",
		"t:full": "pnpm --filter maestro t:full",
		"t:perf": "pnpm --filter maestro t:perf",
		"t:account": "pnpm --filter maestro t:account",
		"verify": "pnpm --filter maestro verify"
	},
	"license": "MIT",
	"repository": "https://github.com/grostel018/Maestro-ymusic",
	"engines": {
		"node": ">=24.14.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.15.1",
	"devDependencies": {
		"vitest": "^4.1.10"
	}
}
