# Maestro Environment Variables
# Copy this file to .env.local and fill in your own keys.
# This file is gitignored - never commit your real tokens.

# Required for @venipa/xosms from GitHub Packages
# Create a PAT at https://github.com/settings/tokens with scope: read:packages
VITE_GITHUB_TOKEN=

# Optional: Last.fm scrobbling and artist/song facts
# Get keys at https://www.last.fm/api
VITE_LASTFM_API=
VITE_LASTFM_SECRET=

# Optional: Genius "behind the song" lyrics cards
# Get token at https://genius.com/api-clients
VITE_GENIUS_TOKEN=